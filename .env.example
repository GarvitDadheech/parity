# ---------------------------------------------------------------------------
# Parity — environment template. Copy to .env and fill in. The real .env is gitignored.
# ---------------------------------------------------------------------------

# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://parity:parity@localhost:5434/parity"

# Where the bot's onboarding link points.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Privy -----------------------------------------------------------------
PRIVY_APP_ID=""
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET="privy_app_secret_..."

# Server signer. The matching public key must be registered in the Privy
# dashboard under Authorization keys. Keypair lives in .secrets/ (gitignored).
PRIVY_AUTHORIZATION_KEY="<base64 PKCS8 P-256 private key>"

# The authorization key's id in the Privy dashboard, needed by the onboarding page
# to grant the server signer.
NEXT_PUBLIC_PRIVY_SIGNER_ID=""

# Optional: a Privy policy id to attach to every wallet Parity creates.
PRIVY_POLICY_ID=""

# --- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
# Echoed back by Telegram on every webhook call; any random string.
TELEGRAM_WEBHOOK_SECRET="<random hex>"

# --- Solana ----------------------------------------------------------------
# Free Helius key. Parity refuses to fall back to the public mainnet RPC.
HELIUS_API_KEY=""
# SOLANA_RPC_URL=""

# --- Jupiter ---------------------------------------------------------------
# Defaults to the free lite-api endpoint; set these only if you hit rate limits.
# JUPITER_API_URL="https://api.jup.ag/swap/v1"
# JUPITER_API_KEY=""

# --- Safety ----------------------------------------------------------------
# Dry run is the default. Every path runs for real except the final signature.
# Set to "false" only for the live demo swap.
DRY_RUN="true"

# Shared secret required by /api/cron/poll.
CRON_SECRET="<random hex>"
